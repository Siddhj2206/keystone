{
  "name": "keystone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "start": "npm start -w mobile"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "@types/jest": "^29.5.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/packages/core/**/*.test.ts",
      "**/apps/mobile/src/lib/**/*.test.ts"
    ]
  }
}
